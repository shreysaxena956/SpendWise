# Server Port configuration
PORT=5000

# PostgreSQL Database Connection String
# The DBMS team member will provide the PostgreSQL credentials and database name.
# Example: postgresql://postgres:password@localhost:5432/spendwise?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/spendwise?schema=public"

# Database Mode:
# Set to 'true' to use the temporary in-memory mock dataset for rapid frontend testing.
# Set to 'false' once the DBMS member provides the finalized schema and PostgreSQL database.
USE_MOCK=true

